angsd -dofasta 2 -setMinDepth 5 -minmapq 30 -minq 30 -uniqueonly 1 -only_proper_pairs 1 -docounts 1 -rf ../../hydineWGT2T_autosome.txt -i ${BAMDIR}/$1.bam -out $1
